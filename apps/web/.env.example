# Everything with a VITE_ prefix is PUBLIC — it ships to the browser.
# The Supabase SERVICE ROLE key must never appear in this file.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Optional. Without it the contact form still works — the honeypot, dwell
# time and IP rate limit remain in force.
VITE_TURNSTILE_SITE_KEY=
